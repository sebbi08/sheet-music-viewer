{
  "name": "sheet-music-viewer",
  "productName": "sheet-music-viewer",
  "version": "1.15.1",
  "description": "App to display music sheets",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package --arch x64",
    "make": "electron-forge make --arch x64",
    "publish": "electron-forge publish --arch x64",
    "semantic-release": "semantic-release --no-ci",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:visual": "vitest run -c vitest.visual.config.mts",
    "prepare": "simple-git-hooks"
  },
  "keywords": [],
  "author": {
    "name": "Sebastian Mahr",
    "email": "sebastian.mahr83@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-flatpak": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/publisher-github": "^8.0.0",
    "@electron/fuses": "2.1.3",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@mdi/font": "7.4.47",
    "@napi-rs/canvas": "1.1.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@trpc/client": "11.26.0",
    "@trpc/server": "11.26.0",
    "@tsconfig/node24": "24.0.6",
    "@types/debug": "4.1.13",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/fontfaceobserver": "2.1.3",
    "@types/fs-extra": "11.0.4",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@types/node-fetch": "2.6.13",
    "@types/pngjs": "6.0.5",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "axios": "^1.20.0",
    "core-js": "3.51.0",
    "debug": "4.4.3",
    "dotenv": "^18.0.0",
    "electron": "45.2.3",
    "electron-devtools-installer": "4.0.0",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "1.0.1",
    "eslint": "10.14.0",
    "fabric": "7.4.0",
    "fontfaceobserver": "2.3.0",
    "form-data": "4.0.6",
    "fs-extra": "11.4.1",
    "glob": "14.0.6",
    "globals": "17.14.0",
    "less": "4.9.1",
    "lodash": "4.18.1",
    "marked": "^18.0.11",
    "material-design-icons": "3.0.1",
    "node-fetch": "3.3.2",
    "pdfjs-dist": "6.5.438",
    "pinia": "^4.0.3",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.65.1",
    "pngjs": "7.0.0",
    "roboto-fontface": "0.10.0",
    "sass": "1.108.2",
    "sass-embedded": "1.108.2",
    "semantic-release": "26.0.1",
    "simple-git-hooks": "^2.13.1",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.1.1",
    "vue": "3.5.46",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.14",
    "vuedraggable": "4.1.0",
    "vuetify": "4.3.4",
    "zod": "^4.4.3"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "dependencies": {
    "electron-trpc": "^1.0.0",
    "pdf-lib": "1.17.1",
    "superjson": "^2.2.6",
    "update-electron-app": "^3.3.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
